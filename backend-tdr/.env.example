# =========================
# CONFIGURACIÓN DEL BACKEND (SISTEMA TDR)
# =========================

# Puerto del servidor backend
PORT=4000

# Orígenes permitidos para CORS (separados por coma si son varios)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Clave secreta para firmar tokens JWT
JWT_SECRET=tu_secreto_jwt_aqui

# URL de conexión a PostgreSQL
# Ejemplo local: postgres://postgres:password@localhost:5432/tdr_db
# Ejemplo remoto (Supabase/Neon/Render): postgres://usuario:password@host.region.aws.neon.tech:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tdr_db

# Storage de Supabase (Opcional si usas almacenamiento local/firmado)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role

# Configuración de Servidor SMTP para Notificaciones por Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-clave-de-aplicacion-gmail
SMTP_FROM=tu-email@gmail.com
SMTP_FROM_NAME=Sistema TdR
